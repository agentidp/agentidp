{
  "name": "@agentidp/mcp",
  "version": "0.1.0",
  "description": "MCP server for the AgentIDP registry. Look up, verify, register and mint agent identities from a coding agent.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "agentidp-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentidp/agentidp.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/agentidp/agentidp/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/agentidp/agentidp/issues"
  },
  "keywords": [
    "agentidp",
    "mcp",
    "model-context-protocol",
    "agent-identity"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentidp/sdk": "workspace:^",
    "@agentidp/verify": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "jose": "^6.2.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

{
  "name": "@agentidp/sdk",
  "version": "0.1.0",
  "description": "Agent-side AgentIDP SDK. Mint ES256 Agent Identity Tokens (AIT).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentidp/agentidp.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/agentidp/agentidp/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/agentidp/agentidp/issues"
  },
  "keywords": [
    "agentidp",
    "ait",
    "jwt",
    "agent-identity"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
